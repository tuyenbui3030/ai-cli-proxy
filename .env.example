# CLIProxyAPI Configuration
# Copy this file to .env and modify as needed

# Container prefix (useful when running multiple instances)
# Default: cli-proxy -> containers: cli-proxy-api, cli-proxy-backup, cli-proxy-restore
CONTAINER_PREFIX=cli-proxy

# Server port (default: 8317)
PORT=8317

# Timezone
TZ=Asia/Ho_Chi_Minh

# API Key for model trigger (warmup at 7am)
TRIGGER_API_KEY=sk-change-this-api-key
API_TOKEN=
BACKUP_INTERVAL=5
BACKUP_RETENTION_DAYS=10