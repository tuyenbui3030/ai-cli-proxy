# CLIProxyAPI Configuration
# Copy this file to .env and modify as needed

# Container prefix (useful when running multiple instances)
# Default: cli-proxy -> containers: cli-proxy-api, cli-proxy-backup, cli-proxy-restore
CONTAINER_PREFIX=cli-proxy

# Server port (default: 8317)
PORT=8317
IP_CHECK_PORT=8327

# Timezone
TZ=Asia/Ho_Chi_Minh

# API Key for model trigger (warmup at 7am)
TRIGGER_API_KEY=sk-change-this-api-key
API_TOKEN=
BACKUP_INTERVAL=5
BACKUP_RETENTION_DAYS=10

# ---------------------------------------------------------------------------
# CPA Usage Keeper (https://github.com/Willxup/cpa-usage-keeper)
# ---------------------------------------------------------------------------
# Dashboard port on host
KEEPER_PORT=8080

# CPA management key (must match an api-key in config.yaml)
CPA_MANAGEMENT_KEY=replace-with-your-management-key

# Login auth for the dashboard
AUTH_ENABLED=true
LOGIN_PASSWORD=replace-with-your-login-password
AUTH_SESSION_TTL=168h

# Optional sub-path (leave empty for root, e.g. /cpa)
APP_BASE_PATH=

# Sync mode: auto | redis | legacy_export
USAGE_SYNC_MODE=auto
REDIS_QUEUE_ADDR=
REDIS_QUEUE_BATCH_SIZE=1000
REDIS_QUEUE_IDLE_INTERVAL=1s

# Polling (used for legacy_export)
KEEPER_POLL_INTERVAL=5m
KEEPER_REQUEST_TIMEOUT=30s

# Logging
KEEPER_LOG_LEVEL=info
KEEPER_LOG_FILE_ENABLED=true
KEEPER_LOG_RETENTION_DAYS=7

# Keeper backup (raw data stored under ./cpa-data)
KEEPER_BACKUP_ENABLED=true
KEEPER_BACKUP_INTERVAL=1h
KEEPER_BACKUP_RETENTION_DAYS=30

# ---------------------------------------------------------------------------
# CPA Manager (https://github.com/seakee/CPA-Manager)
# Management WebUI + Usage Service for CLI Proxy API
# ---------------------------------------------------------------------------
# Dashboard port on host (default: 18317)
MANAGER_PORT=18317